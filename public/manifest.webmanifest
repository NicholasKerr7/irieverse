{
  "id": "/?source=pwa",
  "name": "IrieVerse Travel OS",
  "short_name": "IrieVerse",
  "description": "A Jamaica-first travel OS for exploring places, saving ideas, mapping routes, and building trips.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "orientation": "portrait-primary",
  "background_color": "#020617",
  "theme_color": "#020617",
  "share_target": {
    "action": "/?tab=saved&source=share-target",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "shared_title",
      "text": "shared_text",
      "url": "shared_url"
    }
  },
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/mobile-home.png",
      "sizes": "780x1688",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "IrieVerse mobile home screen"
    },
    {
      "src": "/screenshots/mobile-map.png",
      "sizes": "780x1688",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Interactive Jamaica map with road routes"
    },
    {
      "src": "/screenshots/desktop-home.png",
      "sizes": "2880x2000",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Desktop IrieVerse home screen"
    },
    {
      "src": "/screenshots/desktop-map.png",
      "sizes": "2880x2000",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Desktop Jamaica map route view"
    }
  ],
  "shortcuts": [
    {
      "name": "Explore Jamaica",
      "short_name": "Explore",
      "description": "Browse places and experiences by vibe.",
      "url": "/?tab=explore",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Open Map",
      "short_name": "Map",
      "description": "Open the interactive Jamaica route map.",
      "url": "/?tab=map",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Build Trip",
      "short_name": "Trips",
      "description": "Review itinerary, budget, flights, events, and sharing.",
      "url": "/?tab=trips",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "categories": ["travel", "navigation", "lifestyle"],
  "lang": "en-US",
  "dir": "ltr"
}
