{
  "name": "irieverse-jamaica-travel-os",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.7.0",
  "engines": {
    "node": "20.x",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview",
    "test:api": "node tests/api-place-details.test.cjs",
    "qa:local": "playwright test --config=playwright.local.config.cjs --reporter=line",
    "qa:production": "playwright test tests/production-qa.spec.js --reporter=line",
    "check:maintenance": "node scripts/check-maintenance-config.cjs",
    "verify": "npm run typecheck && npm run test:api && npm run check:maintenance && npm run audit:prod && npm run build",
    "verify:full": "npm run verify && npm run qa:local",
    "audit:prod": "npm audit --omit=dev --audit-level=high --cache=.npm-cache",
    "audit:all": "npm audit --audit-level=moderate --cache=.npm-cache",
    "audit:fix:dry": "npm audit fix --dry-run --cache=.npm-cache",
    "deps:outdated": "npm outdated --cache=.npm-cache || true",
    "maintenance": "npm run audit:prod && npm run deps:outdated"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.81.1",
    "lucide-react": "^0.460.0",
    "maplibre-gl": "^4.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-map-gl": "^7.1.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.2",
    "@vitejs/plugin-react-swc": "^3.7.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3",
    "vite": "^6.0.5"
  }
}
