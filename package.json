{
  "name": "irieverse-jamaica-travel-os",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.7.0",
  "engines": {
    "node": "22.x",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.service-worker.json --noEmit",
    "build": "npm run build:sw && vite build",
    "build:sw": "tsc -p tsconfig.service-worker.json",
    "preview": "vite preview",
    "test:api": "tsx tests/api-place-details.test.ts && tsx tests/api-handlers.test.ts",
    "qa:local": "playwright test --config=playwright.local.config.ts --reporter=line",
    "qa:production": "playwright test tests/production-qa.spec.ts --reporter=line",
    "check:maintenance": "tsx scripts/check-maintenance-config.ts",
    "check:content": "tsx scripts/check-content-media.ts && tsx scripts/check-event-calendar.ts",
    "check:supabase": "tsx scripts/check-supabase-readiness.ts",
    "check:sw": "tsx scripts/check-service-worker-output.ts",
    "verify": "npm run typecheck && npm run test:api && npm run check:maintenance && npm run check:content && npm run check:supabase && npm run check:sw && npm run audit:prod && npm run build",
    "verify:full": "npm run verify && npm run qa:local",
    "audit:prod": "npm audit --omit=dev --audit-level=high --cache=.npm-cache",
    "audit:all": "npm audit --audit-level=moderate --cache=.npm-cache",
    "audit:fix:dry": "npm audit fix --dry-run --cache=.npm-cache",
    "deps:outdated": "npm outdated --cache=.npm-cache || true",
    "maintenance": "npm run audit:prod && npm run deps:outdated"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.81.1",
    "lucide-react": "^0.577.0",
    "maplibre-gl": "^4.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-map-gl": "^7.1.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.19.19",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.2",
    "@vitejs/plugin-react-swc": "^3.7.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.22.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.5"
  }
}
