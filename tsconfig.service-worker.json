{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "WebWorker"
    ],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "rootDir": "service-worker",
    "outDir": "public",
    "types": []
  },
  "include": [
    "service-worker/sw.ts"
  ]
}
